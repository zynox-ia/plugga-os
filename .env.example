# Local development only. Copy to .env and replace placeholders locally.
# Never use production credentials, endpoints, or personal data here.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local Docker Compose services only.
POSTGRES_DB=plugga_os
POSTGRES_USER=plugga_os
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://plugga_os:local_only_change_me@localhost:5432/plugga_os?schema=public
REDIS_URL=redis://localhost:6379

# Local escape hatch only; headers x-dev-principal/x-dev-roles carry synthetic
# values. Real login uses server-side sessions and must be the default path.
# This must never be enabled as production authentication.
DEV_AUTH_ENABLED=true
LOG_LEVEL=info

# --- Auth (ADR-0008) ---
# Signs the session cookie. Use a long random value locally; never commit a real
# secret. Generate one with: openssl rand -base64 48
AUTH_SESSION_SECRET=local_only_session_secret_change_me_at_least_32_chars
# Browser origins accepted on mutating auth routes (comma-separated). Optional
# locally (localhost is accepted by default); required in staging/production.
# AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Base URL used to build invite/reset links.
AUTH_APP_BASE_URL=http://localhost:3000

# Seed admin login for local development only (ADR-0008). Never a real password.
SEED_ADMIN_EMAIL=admin@plugga.local
SEED_ADMIN_PASSWORD=local_only_change_me

# --- Email (ADR-0010) ---
# Safe default never sends. Mailpit/Brevo adapters arrive in a later PR.
EMAIL_PROVIDER=noop
