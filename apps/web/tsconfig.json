{
  "extends": "@plugga/config/tsconfig/next.json",
  "compilerOptions": {
    // `node --test` strips types but resolves like Node ESM, so test imports
    // need the real extension. Safe here: this project never emits (noEmit).
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
