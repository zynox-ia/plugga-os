/// Ordem de serviço da Engenharia (PLU-345), no lugar das tarefas "O.S ..." do
/// Bitrix. Numeração global (OS-0001); a empresa é campo e filtro. Não se apaga
/// e a concluída não reabre: a continuação é outra O.S. com `ordemAnteriorId`.
model OrdemDeServico {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero              Int                        @unique @default(autoincrement())
  companyId           String                     @map("company_id")
  tipo                TipoDeOrdemDeServico
  situacao            SituacaoDaOrdemDeServico   @default(aberta)
  prioridade          PrioridadeDaOrdemDeServico @default(normal)
  origem              OrigemDaOrdemDeServico     @default(manual)
  canal               String?
  /// Entrada pelo robô (PLU-351): grupo e quem pediu no canal. Nunca em evento ou log.
  origemGrupo         String?                    @map("origem_grupo")
  origemSolicitante   String?                    @map("origem_solicitante")
  clientId            String                     @map("client_id") @db.Uuid
  consumerUnitId      String?                    @map("consumer_unit_id") @db.Uuid
  local               String?
  descricao           String
  /// Dia-limite de atendimento: início do dia em Manaus.
  prazo               DateTime                   @db.Timestamptz(6)
  equipamento         String?
  fabricante          String?
  modelo              String?
  numeroSerie         String?                    @map("numero_serie")
  tecnicoId           String?                    @map("tecnico_id") @db.Uuid
  apoioId             String?                    @map("apoio_id") @db.Uuid
  agendadaPara        DateTime?                  @map("agendada_para") @db.Timestamptz(6)
  checkinEm           DateTime?                  @map("checkin_em") @db.Timestamptz(6)
  laudoEncontrado     String?                    @map("laudo_encontrado")
  laudoFeito          String?                    @map("laudo_feito")
  laudoRecomendacao   String?                    @map("laudo_recomendacao")
  laudoEm             DateTime?                  @map("laudo_em") @db.Timestamptz(6)
  laudoPorId          String?                    @map("laudo_por_id") @db.Uuid
  adiamentoMotivo     String?                    @map("adiamento_motivo")
  adiadaPara          DateTime?                  @map("adiada_para") @db.Timestamptz(6)
  adiadaEm            DateTime?                  @map("adiada_em") @db.Timestamptz(6)
  adiadaPorId         String?                    @map("adiada_por_id") @db.Uuid
  cancelamentoMotivo  String?                    @map("cancelamento_motivo")
  canceladaEm         DateTime?                  @map("cancelada_em") @db.Timestamptz(6)
  canceladaPorId      String?                    @map("cancelada_por_id") @db.Uuid
  /// Em que situação estava quando foi cancelada.
  canceladaEmSituacao SituacaoDaOrdemDeServico?  @map("cancelada_em_situacao")
  concluidaEm         DateTime?                  @map("concluida_em") @db.Timestamptz(6)
  ordemAnteriorId     String?                    @map("ordem_anterior_id") @db.Uuid
  /// Usina da O.S. (PLU-347), do mesmo cliente.
  usinaId             String?                    @map("usina_id") @db.Uuid
  /// Obra da O.S. (PLU-350), do mesmo cliente e empresa.
  obraId              String?                    @map("obra_id") @db.Uuid
  criadoPorId         String?                    @map("criado_por_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company                     @relation(fields: [companyId], references: [id])
  client          Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consumerUnit    ConsumerUnit?               @relation(fields: [consumerUnitId], references: [id], onDelete: Restrict)
  tecnico         User?                       @relation("OrdemTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  apoio           User?                       @relation("OrdemApoio", fields: [apoioId], references: [id], onDelete: SetNull)
  laudoPor        User?                       @relation("OrdemLaudoPor", fields: [laudoPorId], references: [id], onDelete: SetNull)
  adiadaPor       User?                       @relation("OrdemAdiadaPor", fields: [adiadaPorId], references: [id], onDelete: SetNull)
  canceladaPor    User?                       @relation("OrdemCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  criadoPor       User?                       @relation("OrdemCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ordemAnterior   OrdemDeServico?             @relation("OrdemContinuacao", fields: [ordemAnteriorId], references: [id], onDelete: Restrict)
  continuacoes    OrdemDeServico[]            @relation("OrdemContinuacao")
  usina           Usina?                      @relation(fields: [usinaId], references: [id], onDelete: Restrict)
  obra            Obra?                       @relation(fields: [obraId], references: [id], onDelete: Restrict)
  resultadosDeMonitoramento ResultadoDaConferencia[]
  usinasComissionadas Usina[]                 @relation("UsinaDoComissionamento")
  historico       HistoricoDeOrdemDeServico[]
  arquivos        ArquivoDeOrdemDeServico[]
  termo           TermoDeOrdemDeServico?
  pedidosDeCompra PedidoDeCompra[]

  @@index([situacao, createdAt])
  @@index([tecnicoId, agendadaPara])
  @@index([clientId])
  @@map("ordens_de_servico")
}

/// Linha do tempo da O.S. Só se insere: nem UPDATE nem DELETE.
model HistoricoDeOrdemDeServico {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordemId String   @map("ordem_id") @db.Uuid
  tipo    String
  /// Dados da passagem (datas, técnico); nunca o documento de quem assinou.
  dados   Json     @default("{}") @db.JsonB
  detalhe String?
  porId   String?  @map("por_id") @db.Uuid
  em      DateTime @default(now()) @db.Timestamptz(6)

  ordem OrdemDeServico @relation(fields: [ordemId], references: [id], onDelete: Restrict)
  por   User?          @relation("HistoricoDeOrdemPor", fields: [porId], references: [id], onDelete: SetNull)

  @@index([ordemId, em])
  @@map("historico_de_ordens_de_servico")
}

/// Foto do laudo, assinatura desenhada ou PDF do termo, no armazenamento do
/// Plugga OS. Nunca se apaga: o UPDATE só marca a substituição, uma vez.
model ArquivoDeOrdemDeServico {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordemId          String                    @map("ordem_id") @db.Uuid
  categoria        CategoriaDeArquivoDaOrdem
  arquivoChave     String                    @map("arquivo_chave")
  arquivoNome      String                    @map("arquivo_nome")
  arquivoTamanho   Int                       @map("arquivo_tamanho")
  arquivoTipo      String                    @map("arquivo_tipo")
  enviadoPorId     String?                   @map("enviado_por_id") @db.Uuid
  enviadoEm        DateTime                  @default(now()) @map("enviado_em") @db.Timestamptz(6)
  substituidoEm    DateTime?                 @map("substituido_em") @db.Timestamptz(6)
  substituidoPorId String?                   @map("substituido_por_id") @db.Uuid

  ordem           OrdemDeServico         @relation(fields: [ordemId], references: [id], onDelete: Restrict)
  enviadoPor      User?                  @relation("ArquivoDeOrdemEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  substituidoPor  User?                  @relation("ArquivoDeOrdemSubstituidoPor", fields: [substituidoPorId], references: [id], onDelete: SetNull)
  termoAssinatura TermoDeOrdemDeServico? @relation("TermoAssinatura")
  termoPdf        TermoDeOrdemDeServico? @relation("TermoPdf")

  @@index([ordemId, categoria, enviadoEm])
  @@map("arquivos_de_ordens_de_servico")
}

/// Termo assinado (E2). Um por O.S., porque a concluída não reabre. O documento
/// de quem assina fica só aqui e no PDF; nunca em evento, log ou histórico.
model TermoDeOrdemDeServico {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordemId             String                  @unique @map("ordem_id") @db.Uuid
  modo                ModoDeAssinaturaDoTermo
  nome                String?
  documento           String?
  assinaturaArquivoId String?                 @unique @map("assinatura_arquivo_id") @db.Uuid
  pdfArquivoId        String                  @unique @map("pdf_arquivo_id") @db.Uuid
  coletadoPorId       String?                 @map("coletado_por_id") @db.Uuid
  assinadoEm          DateTime                @default(now()) @map("assinado_em") @db.Timestamptz(6)

  ordem             OrdemDeServico           @relation(fields: [ordemId], references: [id], onDelete: Restrict)
  assinaturaArquivo ArquivoDeOrdemDeServico? @relation("TermoAssinatura", fields: [assinaturaArquivoId], references: [id], onDelete: Restrict)
  pdfArquivo        ArquivoDeOrdemDeServico  @relation("TermoPdf", fields: [pdfArquivoId], references: [id], onDelete: Restrict)
  coletadoPor       User?                    @relation("TermoDeOrdemColetadoPor", fields: [coletadoPorId], references: [id], onDelete: SetNull)

  @@map("termos_de_ordens_de_servico")
}

// ---------------------------------------------------------------- Tarefas dos departamentos (PLU-349, PLU-340)

enum EmpresaDaTarefa {
  plugga
  waze
  ambas

  @@map("empresa_da_tarefa")
}

enum TipoDeTarefa {
  unica
  recorrente

  @@map("tipo_de_tarefa")
}

enum OrigemDaTarefa {
  criada
  do_departamento

  @@map("origem_da_tarefa")
}

/// Tarefa do departamento (Financeiro, Engenharia, Energia): única ou recorrente.
/// Não se apaga; a recorrente para de gerar ocorrências quando é encerrada.
model Tarefa {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departamento       String
  titulo             String
  categoria          String?
  empresa            EmpresaDaTarefa
  responsavelId      String          @map("responsavel_id") @db.Uuid
  substitutoId       String?         @map("substituto_id") @db.Uuid
  tipo               TipoDeTarefa
  origem             OrigemDaTarefa  @default(criada)
  /// Recorrente: a regra (`regraDeRecorrenciaSchema`). Única: nula.
  regra              Json?           @db.JsonB
  /// Única: o dia. Recorrente: o início. Início do dia em Manaus.
  dia                DateTime        @db.Timestamptz(6)
  horarioLimite      String          @map("horario_limite")
  exigeEvidencia     Boolean         @map("exige_evidencia")
  exigeResultado     Boolean         @map("exige_resultado")
  instrucoes         String[]        @default([])
  /// Concluída pelo sistema (`automacoesDeTarefa`); ninguém a conclui pela tela.
  automacao          String?
  atalho             String?
  /// Último dia (início, em Manaus) com as ocorrências já geradas.
  geradaAte          DateTime?       @map("gerada_ate") @db.Timestamptz(6)
  encerradaEm        DateTime?       @map("encerrada_em") @db.Timestamptz(6)
  encerradaPorId     String?         @map("encerrada_por_id") @db.Uuid
  encerramentoMotivo String?         @map("encerramento_motivo")
  criadoPorId        String?         @map("criado_por_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  responsavel  User                 @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  substituto   User?                @relation("TarefaSubstituto", fields: [substitutoId], references: [id], onDelete: SetNull)
  encerradaPor User?                @relation("TarefaEncerradaPor", fields: [encerradaPorId], references: [id], onDelete: SetNull)
  criadoPor    User?                @relation("TarefaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ocorrencias  OcorrenciaDeTarefa[]

  @@index([departamento, encerradaEm])
  @@map("tarefas")
}

/// A tarefa num dia: o que aparece na lista e se conclui. A concluída não muda.
model OcorrenciaDeTarefa {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tarefaId       String    @map("tarefa_id") @db.Uuid
  /// Início do dia em Manaus.
  dia            DateTime  @db.Timestamptz(6)
  prazoEm        DateTime  @map("prazo_em") @db.Timestamptz(6)
  concluidaEm    DateTime? @map("concluida_em") @db.Timestamptz(6)
  concluidaPorId String?   @map("concluida_por_id") @db.Uuid
  resultado      String?
  /// Uma marca por instrução da tarefa, na mesma ordem.
  checklist      Boolean[] @default([])
  automatica     Boolean   @default(false)
  /// A tarefa foi encerrada antes deste dia: a ocorrência sai da lista.
  canceladaEm    DateTime? @map("cancelada_em") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tarefa      Tarefa              @relation(fields: [tarefaId], references: [id], onDelete: Restrict)
  concluidaPor User?              @relation("OcorrenciaConcluidaPor", fields: [concluidaPorId], references: [id], onDelete: SetNull)
  evidencias  EvidenciaDeTarefa[]

  @@unique([tarefaId, dia])
  @@index([dia])
  @@map("ocorrencias_de_tarefa")
}

/// Print, foto ou PDF anexado ao concluir. Só se insere.
model EvidenciaDeTarefa {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocorrenciaId   String   @map("ocorrencia_id") @db.Uuid
  arquivoChave   String   @map("arquivo_chave")
  arquivoNome    String   @map("arquivo_nome")
  arquivoTamanho Int      @map("arquivo_tamanho")
  arquivoTipo    String   @map("arquivo_tipo")
  enviadoPorId   String?  @map("enviado_por_id") @db.Uuid
  enviadoEm      DateTime @default(now()) @map("enviado_em") @db.Timestamptz(6)

  ocorrencia OcorrenciaDeTarefa @relation(fields: [ocorrenciaId], references: [id], onDelete: Restrict)
  enviadoPor User?              @relation("EvidenciaDeTarefaEnviadaPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([ocorrenciaId])
  @@map("evidencias_de_tarefa")
}

/// Configuração de um tipo de O.S. (PLU-349, Configurações da Engenharia): o
/// prazo padrão em dias úteis, que sugere o prazo da Nova O.S., e quem agenda.
/// Sem linha, o tipo usa o padrão do código. Não se apaga.
model ConfiguracaoDeTipoDeOrdem {
  tipo                 TipoDeOrdemDeServico @id
  prazoPadraoDiasUteis Int                  @map("prazo_padrao_dias_uteis")
  agendadorId          String?              @map("agendador_id") @db.Uuid
  atualizadoPorId      String?              @map("atualizado_por_id") @db.Uuid
  atualizadoEm         DateTime             @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  agendador     User? @relation("TipoDeOrdemAgendador", fields: [agendadorId], references: [id], onDelete: SetNull)
  atualizadoPor User? @relation("TipoDeOrdemAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracoes_de_tipo_de_ordem")
}

// ---------------------------------------------------------------- Engenharia: usinas e monitoramento (PLU-347)

enum SituacaoDoMonitoramento {
  normal
  anomalia
  sem_comunicacao

  @@map("situacao_do_monitoramento")
}

enum OrigemDaUsina {
  manual
  importacao
  comissionamento

  @@map("origem_da_usina")
}

/// Plataforma de inversor (Growatt, FusionSolar...). A observação de acesso diz
/// onde está o acesso; nunca guarda senha. Não se apaga: sai de uso por `ativa`.
model PlataformaDeInversor {
  id                 String   @id
  nome               String   @unique
  observacaoDeAcesso String?  @map("observacao_de_acesso")
  ativa              Boolean  @default(true)
  ordem              Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  usinas        Usina[]
  conferencias  ConferenciaDePlataforma[]

  @@map("plataformas_de_inversor")
}

/// Usina de cliente monitorada pela Engenharia. Não se apaga: sai de uso por `ativa`.
model Usina {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String         @map("company_id")
  clientId                 String         @map("client_id") @db.Uuid
  consumerUnitId           String         @map("consumer_unit_id") @db.Uuid
  nome                     String
  plataformaId             String         @map("plataforma_id")
  potenciaKwp              Decimal        @map("potencia_kwp") @db.Decimal(10, 3)
  fabricante               String?
  modelo                   String?
  numeroSerie              String?        @map("numero_serie")
  /// Início do dia do comissionamento, em Manaus.
  comissionadaEm           DateTime       @map("comissionada_em") @db.Timestamptz(6)
  garantiaAte              DateTime?      @map("garantia_ate") @db.Timestamptz(6)
  origem                   OrigemDaUsina  @default(manual)
  ordemDeComissionamentoId String?        @map("ordem_de_comissionamento_id") @db.Uuid
  ativa                    Boolean        @default(true)
  criadoPorId              String?        @map("criado_por_id") @db.Uuid
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                Company                  @relation(fields: [companyId], references: [id])
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consumerUnit           ConsumerUnit             @relation(fields: [consumerUnitId], references: [id], onDelete: Restrict)
  plataforma             PlataformaDeInversor     @relation(fields: [plataformaId], references: [id], onDelete: Restrict)
  ordemDeComissionamento OrdemDeServico?          @relation("UsinaDoComissionamento", fields: [ordemDeComissionamentoId], references: [id], onDelete: Restrict)
  criadoPor              User?                    @relation("UsinaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ordensDeServico        OrdemDeServico[]
  resultados             ResultadoDaConferencia[]

  @@index([plataformaId, companyId, ativa])
  @@index([clientId])
  @@map("usinas")
}

/// A conferência de uma plataforma, para uma empresa, num dia, com o print. Só se insere.
model ConferenciaDePlataforma {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plataformaId   String   @map("plataforma_id")
  companyId      String   @map("company_id")
  /// Início do dia em Manaus.
  dia            DateTime @db.Timestamptz(6)
  conferidaPorId String?  @map("conferida_por_id") @db.Uuid
  conferidaEm    DateTime @default(now()) @map("conferida_em") @db.Timestamptz(6)
  printChave     String   @map("print_chave")
  printNome      String   @map("print_nome")
  printTamanho   Int      @map("print_tamanho")
  printTipo      String   @map("print_tipo")

  plataforma   PlataformaDeInversor     @relation(fields: [plataformaId], references: [id], onDelete: Restrict)
  company      Company                  @relation(fields: [companyId], references: [id])
  conferidaPor User?                    @relation("ConferenciaConferidaPor", fields: [conferidaPorId], references: [id], onDelete: SetNull)
  resultados   ResultadoDaConferencia[]

  @@unique([plataformaId, companyId, dia])
  @@index([dia])
  @@map("conferencias_de_plataforma")
}

/// Como cada usina estava na conferência. Só se insere.
model ResultadoDaConferencia {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conferenciaId    String                  @map("conferencia_id") @db.Uuid
  usinaId          String                  @map("usina_id") @db.Uuid
  situacao         SituacaoDoMonitoramento
  nota             String?
  ordemDeServicoId String?                 @map("ordem_de_servico_id") @db.Uuid

  conferencia    ConferenciaDePlataforma @relation(fields: [conferenciaId], references: [id], onDelete: Restrict)
  usina          Usina                   @relation(fields: [usinaId], references: [id], onDelete: Restrict)
  ordemDeServico OrdemDeServico?         @relation(fields: [ordemDeServicoId], references: [id], onDelete: Restrict)

  @@unique([conferenciaId, usinaId])
  @@index([usinaId])
  @@map("resultados_da_conferencia")
}

// ---------------------------------------------------------------- Protocolos na distribuidora (PLU-348)

enum TipoDeProtocolo {
  orcamento_de_conexao
  liberacao
  cusd
  carta_denuncia
  permanencia_no_cativo
  retorno_ao_cativo
  outros

  @@map("tipo_de_protocolo")
}

enum SituacaoDoProtocolo {
  aberto
  em_analise
  com_pendencia
  respondido
  liberado
  indeferido

  @@map("situacao_do_protocolo")
}

/// Catálogo de distribuidoras. Não se apaga: sai de uso por `ativa`.
model Distribuidora {
  id        String   @id
  nome      String   @unique
  sigla     String?
  uf        String?
  ativa     Boolean  @default(true)
  /// Endereço da Agência Virtual (só https, sem credencial). Login e senha ficam no cofre.
  agenciaVirtualUrl String? @map("agencia_virtual_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  protocolos Protocolo[]

  @@map("distribuidoras")
}

/// Protocolo de um pedido na distribuidora, da Engenharia ou do Operacional
/// (energia-opm). Não se apaga; encerra pela situação.
model Protocolo {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String              @map("company_id")
  departamento       String
  clientId           String              @map("client_id") @db.Uuid
  consumerUnitId     String              @map("consumer_unit_id") @db.Uuid
  distribuidoraId    String              @map("distribuidora_id")
  tipo               TipoDeProtocolo
  numero             String
  /// Início do dia em Manaus.
  abertoEm           DateTime            @map("aberto_em") @db.Timestamptz(6)
  dataLimite         DateTime            @map("data_limite") @db.Timestamptz(6)
  proximaVerificacao DateTime?           @map("proxima_verificacao") @db.Timestamptz(6)
  situacao           SituacaoDoProtocolo @default(aberto)
  acaoPendente       String?             @map("acao_pendente")
  observacao         String?
  encerradoEm        DateTime?           @map("encerrado_em") @db.Timestamptz(6)
  criadoPorId        String?             @map("criado_por_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company                  @relation(fields: [companyId], references: [id])
  client        Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consumerUnit  ConsumerUnit             @relation(fields: [consumerUnitId], references: [id], onDelete: Restrict)
  distribuidora Distribuidora            @relation(fields: [distribuidoraId], references: [id], onDelete: Restrict)
  criadoPor     User?                    @relation("ProtocoloCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  verificacoes  VerificacaoDeProtocolo[]
  documentosDeObra DocumentoDeObra[]

  @@unique([distribuidoraId, numero])
  @@index([departamento, situacao])
  @@index([proximaVerificacao])
  @@index([consumerUnitId])
  @@map("protocolos")
}

/// Uma verificação do protocolo, com o resultado e a próxima. Só se insere.
model VerificacaoDeProtocolo {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocoloId        String              @map("protocolo_id") @db.Uuid
  porId              String?             @map("por_id") @db.Uuid
  em                 DateTime            @default(now()) @db.Timestamptz(6)
  situacaoAnterior   SituacaoDoProtocolo @map("situacao_anterior")
  situacao           SituacaoDoProtocolo
  nota               String?
  acaoPendente       String?             @map("acao_pendente")
  proximaVerificacao DateTime?           @map("proxima_verificacao") @db.Timestamptz(6)

  protocolo Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Restrict)
  por       User?     @relation("VerificacaoDeProtocoloPor", fields: [porId], references: [id], onDelete: SetNull)

  @@index([protocoloId, em])
  @@map("verificacoes_de_protocolo")
}
