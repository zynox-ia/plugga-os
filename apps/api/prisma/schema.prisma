/// Password credential, 1:1 with a user. Argon2id hash only; never logged.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Vínculo com um provedor federado de identidade (hoje só o Google). É aditivo
/// e independente de `UserCredential`: a pessoa pode ter senha, Google, ou os
/// dois. O Google prova QUEM é; quem decide se entra continua sendo
/// `users.status` + o acesso local (ADR-0008, adendo de 2026-08-10).
///
/// A identidade permanente é `subject` (a claim `sub` do Google), nunca o
/// e-mail: e-mail muda de dono e de grafia, `sub` não. Os e-mails guardados são
/// para suporte e auditoria do vínculo, e nenhum login posterior autentica por
/// eles. Nada de token (ID, access ou refresh) é persistido aqui.
model UserIdentity {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  subject           String
  /// E-mail com que o vínculo foi criado. Congelado: é a prova de por que este
  /// `sub` foi associado a esta pessoa.
  emailAtLink       String   @map("email_at_link")
  /// Último e-mail observado nas claims. Muda sem trocar a identidade.
  lastObservedEmail String   @map("last_observed_email")
  /// Claim `hd` do Google Workspace, quando existir. Nulo para Gmail.
  hostedDomain      String?  @map("hosted_domain")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt       DateTime @default(now()) @map("last_login_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Um `sub` pertence a uma pessoa só — sem isto, duas contas locais poderiam
  /// ser abertas pela mesma conta Google.
  @@unique([provider, subject])
  /// E uma pessoa tem no máximo uma conta Google — trocar de conta é ato
  /// administrativo, não algo que um login silenciosamente reatribui.
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

/// Opaque server-side session. Only the token hash is stored; revocation is a
/// delete. Sliding expiry (expiresAt) capped by an absolute deadline.
model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ip                String?
  userAgent         String?   @map("user_agent")
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  mfaRevision       Int?      @map("mfa_revision")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Opt-in factor; unfinished enrollment never replaces the active secret.
model UserMfa {
  userId             String    @id @map("user_id") @db.Uuid
  encryptedSecret    String?   @map("encrypted_secret")
  revision           Int       @default(0)
  recoveryHashes     String[]  @default([]) @map("recovery_hashes")
  lastTotpStep       Int       @default(-1) @map("last_totp_step")
  pendingSecret      String?   @map("pending_secret")
  pendingExpiresAt   DateTime? @map("pending_expires_at") @db.Timestamptz(6)
  pendingSessionHash String?   @map("pending_session_hash")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  blockedUntil       DateTime? @map("blocked_until") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Hash of an opaque pre-session capability; never authorizes normal API reads.
model MfaChallenge {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  revision   Int
  rememberMe Boolean  @map("remember_me")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  attempts   Int      @default(0)
  method     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// Single-use invite/reset token. Only the hash is stored; consumedAt marks use.
model AuthToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Role {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String             @unique
  name          String
  platformUsers UserPlatformRole[]

  @@map("roles")
}

/// Empresa do grupo. Catálogo fixo (`plugga`, `waze`) e a chave é o próprio id,
/// o mesmo que a navegação usa em apps/web/app/lib/organizacao.ts: um uuid
/// separado obrigaria toda tela e todo link a traduzir id↔chave sem ganhar nada.
/// Não é tenant — o sistema segue single-tenant (ADR-0008); é o contexto de
/// negócio dentro do mesmo cliente.
model Company {
  id        String           @id
  name      String
  /// Só os 14 dígitos; referência para conferir a conexão do OMIE (PLU-342). Só a plataforma grava.
  cnpj      String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  obras     Obra[]
  pedidos   PedidoDeCompra[]
  itensDeEstoque ItemDeEstoque[]
  categoriasFinanceiras CategoriaFinanceira[]
  contasCorrentes ContaCorrente[]
  lancamentos Lancamento[]
  omieConexao OmieConexao?
  omieEnvios OmieEnvio[]
  omieLancamentos OmieLancamento[]
  omieCategorias OmieCategoria[]
  omieContasCorrentes OmieContaCorrente[]
  extratosBancarios ExtratoBancario[]
  movimentosDoExtrato MovimentoDoExtrato[]
  omiePausas OmiePausa[]
  pipelines Pipeline[]
  ordensDeServico OrdemDeServico[]
  usinas Usina[]
  protocolos Protocolo[]
  conferenciasDePlataforma ConferenciaDePlataforma[]

  @@map("companies")
}

/// Papel de plataforma: `admin` ou `desenvolvedor` (que leva também a linha
/// `admin`, contada pela regra do último admin). Alcança todo o sistema.
model UserPlatformRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_platform_roles")
}

enum NivelDeDepartamento {
  membro
  gerente

  @@map("nivel_de_departamento")
}

/// Acesso no modelo de 4 papéis (`packages/shared/src/acesso.ts`): a pessoa é
/// membro ou gerente de um departamento, sem empresa. Admin e desenvolvedor
/// ficam em `UserPlatformRole` e não têm linha aqui.
model UserDepartamento {
  userId        String              @map("user_id") @db.Uuid
  departamento  String
  nivel         NivelDeDepartamento
  telas         String[]            @default([])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentIdentity AgentIdentity?

  @@id([userId, departamento])
  @@index([departamento])
  @@map("user_departamentos")
}

/// Identidade de IA: participa da equipe como membro de um único departamento.
/// Credencial opaca revogável; só o hash fica no banco, nunca no diretório.
model AgentIdentity {
  userId              String           @id @map("user_id") @db.Uuid
  departamento        String
  tokenHash           String?          @unique @map("token_hash")
  credentialExpiresAt DateTime?        @map("credential_expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Escopo por ação (B-01, PLU-351): catálogo `acoesDeAgente` de packages/shared.
  acoes               String[]         @default([])
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          UserDepartamento @relation(fields: [userId, departamento], references: [userId, departamento], onDelete: NoAction, onUpdate: NoAction, map: "agent_identities_membership_fkey")
  actions             AgentAction[]
  pedidos             PedidoDeAgente[]

  @@unique([userId, departamento])
  @@map("agent_identities")
}

/// Pedido de um agente por chave de idempotência (PLU-351): o mesmo pedido
/// repetido devolve a entidade criada da primeira vez. Só por inserção.
model PedidoDeAgente {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentUserId String        @map("agent_user_id") @db.Uuid
  chave       String
  acao        String
  /// sha256 do corpo canônico; nunca o corpo em claro.
  hashDoCorpo String        @map("hash_do_corpo")
  entityType  String        @map("entity_type")
  entityId    String        @map("entity_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  identidade  AgentIdentity @relation(fields: [agentUserId], references: [userId], onDelete: Restrict)

  @@unique([agentUserId, chave])
  @@map("pedidos_de_agente")
}

/// Append-only audit record. The initial migration prevents UPDATE and DELETE.
model AgentAction {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent          String
  agentUserId    String?        @map("agent_user_id") @db.Uuid
  requestedById  String?        @map("requested_by") @db.Uuid
  channel        String
  action         String
  entityType     String         @map("entity_type")
  entityId       String         @map("entity_id")
  input          Json           @db.JsonB
  payload        Json           @db.JsonB
  decision       String
  approvalStatus String         @map("approval_status")
  status         String
  result         String?
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  requestedBy    User?          @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  identity       AgentIdentity? @relation(fields: [agentUserId], references: [userId], onDelete: Restrict)

  @@index([requestedById])
  @@index([agentUserId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("agent_actions")
}

/// Append-only event record. actorId is polymorphic by actorType.
model EventLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName  String    @map("event_name")
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  payload    Json      @db.JsonB
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventName, occurredAt])
  @@index([entityType, entityId])
  @@map("event_log")
}

model Integration {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String            @unique
  name       String
  mode       IntegrationMode   @default(mock)
  status     IntegrationStatus @default(unknown)
  lastSyncAt DateTime?         @map("last_sync_at") @db.Timestamptz(6)
  lastError  String?           @map("last_error")
  owner      String
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobRuns    JobRun[]

  @@map("integrations")
}

/// Read-only mirror of Bitrix records, one row per (domain, external record)
/// (ADR-0009). Raw payload staging into the OS Postgres; mapping to OS domain
/// models is later phase work. Idempotent upsert keyed by (domain, externalId);
/// sourceFingerprint lets a re-import skip unchanged records.
model BitrixMirrorRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain            String
  externalId        String   @map("external_id")
  payload           Json     @db.JsonB
  sourceFingerprint String   @map("source_fingerprint")
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([domain, externalId])
  @@index([domain])
  @@map("bitrix_mirror_records")
}

model JobRun {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey        String       @map("job_key")
  integrationId String?      @map("integration_id") @db.Uuid
  scheduledFor  DateTime?    @map("scheduled_for") @db.Timestamptz(6)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(6)
  status        JobRunStatus
  attempt       Int          @default(1)
  durationMs    Int?         @map("duration_ms")
  error         String?
  triggeredBy   String       @map("triggered_by")
  logRef        String?      @map("log_ref")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([jobKey, scheduledFor])
  @@index([integrationId])
  @@map("job_runs")
}

model EvUser {
