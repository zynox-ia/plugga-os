model Partner {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String       @unique
  name        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  locations   Location[]
  settlements Settlement[]

  @@map("partners")
}

model Location {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String         @map("partner_id") @db.Uuid
  name      String
  status    LocationStatus @default(unknown)
  timezone  String         @default("America/Manaus")
  partner   Partner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  stations  Station[]
  sessions  EvSession[]
  incidents Incident[]

  @@index([partnerId, status])
  @@map("locations")
}

model Station {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String      @map("location_id") @db.Uuid
  name       String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  connectors Connector[]

  @@map("stations")
}

model Connector {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId String      @map("station_id") @db.Uuid
  label     String
  status    String      @default("unknown")
  station   Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sessions  EvSession[]

  @@map("connectors")
}

model EvSession {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId     String          @unique @map("external_id")
  userId         String          @map("user_id") @db.Uuid
  locationId     String          @map("location_id") @db.Uuid
  connectorId    String?         @map("connector_id") @db.Uuid
  tokenRfid      String?         @map("token_rfid")
  status         EvSessionStatus
  startedAt      DateTime        @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(6)
  kwh            Decimal?        @db.Decimal(14, 3)
  amount         Decimal?        @db.Decimal(14, 2)
  user           EvUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  connector      Connector?      @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  incidents      Incident[]
  settlementLine SettlementLine?
  contacts       EvContact[]
