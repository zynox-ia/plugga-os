// ---------------------------------------------------------------------------
// Estoque de Suprimentos (PLU-332). Saldo derivado das movimentações, que são
// só de inserção; a reserva nasce do pedido de compra atendido pelo estoque.
// ---------------------------------------------------------------------------

enum EstoqueCategoria {
  kit_solar
  material_eletrico
  material_de_obra
  ferramenta
  escritorio
  outros

  @@map("estoque_categoria")
}

enum EstoqueMovimentacaoTipo {
  entrada
  saida
  ajuste
  reserva
  liberacao

  @@map("estoque_movimentacao_tipo")
}

enum EstoqueOrigemEntrada {
  compra
  devolucao
  saldo_inicial
  outra

  @@map("estoque_origem_entrada")
}

enum EstoqueDestinoSaida {
  obra
  cliente
  interno

  @@map("estoque_destino_saida")
}

enum EstoqueReservaEstado {
  ativa
  baixada
  liberada

  @@map("estoque_reserva_estado")
}

/// Item de estoque de uma empresa. `emEstoque` e `reservado` são o saldo
/// acumulado das movimentações, gravado na transação de cada uma; nunca digitado.
model ItemDeEstoque {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String           @map("company_id")
  codigo               String
  nome                 String
  categoria            EstoqueCategoria
  unidade              String
  estoqueMinimo        Decimal          @default(0) @map("estoque_minimo") @db.Decimal(14, 3)
  emEstoque            Decimal          @default(0) @map("em_estoque") @db.Decimal(14, 3)
  reservado            Decimal          @default(0) @db.Decimal(14, 3)
  custoMedio           Decimal?         @map("custo_medio") @db.Decimal(14, 4)
  ativo                Boolean          @default(true)
  observacoes          String?
  ultimaMovimentacaoEm DateTime?        @map("ultima_movimentacao_em") @db.Timestamptz(6)
  criadoPorId          String?          @map("criado_por_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company                 @relation(fields: [companyId], references: [id])
  criadoPor     User?                   @relation("ItemDeEstoqueCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  reservas      ReservaDeEstoque[]
  movimentacoes MovimentacaoDeEstoque[]
  itensDePedido ItemDePedido[]

  @@unique([companyId, codigo])
  @@index([ativo, nome])
  @@map("itens_de_estoque")
}

/// Reserva de um item para um item de pedido de compra atendido pelo estoque.
model ReservaDeEstoque {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId         String               @map("item_id") @db.Uuid
  pedidoId       String               @map("pedido_id") @db.Uuid
  itemDoPedidoId String               @map("item_do_pedido_id") @db.Uuid
  quantidade     Decimal              @db.Decimal(14, 3)
  estado         EstoqueReservaEstado @default(ativa)
  reservadaEm    DateTime             @default(now()) @map("reservada_em") @db.Timestamptz(6)
  reservadaPorId String?              @map("reservada_por_id") @db.Uuid
  encerradaEm    DateTime?            @map("encerrada_em") @db.Timestamptz(6)
  encerradaPorId String?              @map("encerrada_por_id") @db.Uuid

  item          ItemDeEstoque           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  pedido        PedidoDeCompra          @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  itemDoPedido  ItemDePedido            @relation(fields: [itemDoPedidoId], references: [id], onDelete: Restrict)
  reservadaPor  User?                   @relation("ReservaDeEstoqueFeitaPor", fields: [reservadaPorId], references: [id], onDelete: SetNull)
  encerradaPor  User?                   @relation("ReservaDeEstoqueEncerradaPor", fields: [encerradaPorId], references: [id], onDelete: SetNull)
  movimentacoes MovimentacaoDeEstoque[]

  @@index([itemId, estado])
  @@index([pedidoId])
  @@map("reservas_de_estoque")
}

/// Movimentação de estoque. Só de inserção (trigger); corrige-se com ajuste.
model MovimentacaoDeEstoque {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId              String                  @map("item_id") @db.Uuid
  tipo                EstoqueMovimentacaoTipo
  /// Início do dia da movimentação em Manaus.
  data                DateTime                @db.Timestamptz(6)
  quantidade          Decimal                 @db.Decimal(14, 3)
  custoUnitario       Decimal?                @map("custo_unitario") @db.Decimal(14, 4)
  custoMedioNoMomento Decimal?                @map("custo_medio_no_momento") @db.Decimal(14, 4)
  origem              EstoqueOrigemEntrada?
  destino             EstoqueDestinoSaida?
  obraId              String?                 @map("obra_id") @db.Uuid
  clientId            String?                 @map("client_id") @db.Uuid
  area                String?
  pedidoId            String?                 @map("pedido_id") @db.Uuid
  reservaId           String?                 @map("reserva_id") @db.Uuid
  observacao          String?
  saldoDepois         Decimal                 @map("saldo_depois") @db.Decimal(14, 3)
  registradaPorId     String?                 @map("registrada_por_id") @db.Uuid
  registradaEm        DateTime                @default(now()) @map("registrada_em") @db.Timestamptz(6)

  item          ItemDeEstoque     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  obra          Obra?             @relation(fields: [obraId], references: [id], onDelete: Restrict)
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pedido        PedidoDeCompra?   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  reserva       ReservaDeEstoque? @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  registradaPor User?             @relation("MovimentacaoDeEstoqueRegistradaPor", fields: [registradaPorId], references: [id], onDelete: Restrict)

  @@index([itemId, registradaEm])
  @@index([data])
  @@index([pedidoId])
  @@map("movimentacoes_de_estoque")
}

// ---------------------------------------------------------------- Financeiro (PLU-336)

enum FinanceiroTipoLancamento {
  saida
  entrada

  @@map("financeiro_tipo_lancamento")
}

enum FinanceiroEtapa {
  aberta
  aprovada
  paga
  gerada
  nf_emitida
  boleto_gerado
  enviada
  recebida
  conciliada

  @@map("financeiro_etapa")
}

enum FinanceiroForma {
  pix
  boleto
  cartao_credito
  transferencia
  debito_automatico

  @@map("financeiro_forma")
}

enum FinanceiroOrigem {
  avulsa
  pedido_de_compra
  agente
  cobranca_manual
  /// Nascem pagos na Conciliação, sem a aprovação F2 (PLU-339, C5).
  tarifa_bancaria
  conciliacao
  /// As duas pernas de uma transferência entre contas (C6): sem a aprovação F2, fora dos cards.
  transferencia

  @@map("financeiro_origem")
}

enum FinanceiroEstadoOmie {
  nao_enviado
  enviando
  enviado
  erro
  baixado
  divergente

  @@map("financeiro_estado_omie")
}

enum FinanceiroTipoCategoria {
  receita
  despesa

  @@map("financeiro_tipo_categoria")
}

enum FinanceiroNaturezaCategoria {
  receita
  material
  servico
  telecom
  aluguel
  locacao
  imposto
  pessoal
  tarifa
  outros

  @@map("financeiro_natureza_categoria")
}

/// Espelho de uma categoria do plano de contas do OMIE da empresa. `natureza`
/// (o ícone) é do Plugga OS.
model CategoriaFinanceira {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String                      @map("company_id")
  codigo    String
  nome      String
  tipo      FinanceiroTipoCategoria
  natureza  FinanceiroNaturezaCategoria
  grupoNome String                      @map("grupo_nome")
  ativa     Boolean                     @default(true)
  /// A categoria do "Criar tarifa" da Conciliação: uma por empresa, só de despesa ativa (PLU-339).
  tarifaBancaria Boolean                @default(false) @map("tarifa_bancaria")
  lidaEm    DateTime?                   @map("lida_em") @db.Timestamptz(6)
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  lancamentos Lancamento[]
  /// O vínculo com o OMIE, do conector.
  omie        OmieCategoria?

  @@unique([companyId, codigo])
  @@unique([id, companyId])
  @@map("categorias_financeiras")
}

/// Espelho de uma conta corrente do OMIE da empresa. Somente leitura na tela.
model ContaCorrente {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id")
  omieCodigo  String?   @map("omie_codigo")
  nome        String
  banco       String?
  agencia     String?
  numero      String?
  saldo       Decimal?  @db.Decimal(14, 2)
  saldoLidoEm DateTime? @map("saldo_lido_em") @db.Timestamptz(6)
  /// O saldo informado pela gerência e o dia dele (início do dia de Manaus); os dois juntos.
  saldoInicial   Decimal?  @map("saldo_inicial") @db.Decimal(14, 2)
  saldoInicialEm DateTime? @map("saldo_inicial_em") @db.Timestamptz(6)
  ativa       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  lancamentos Lancamento[]
  /// O vínculo com o OMIE, do conector.
  omie        OmieContaCorrente?
  extratos    ExtratoBancario[]
  movimentosDoExtrato MovimentoDoExtrato[]
  transferenciasDeOrigem  Transferencia[] @relation("TransferenciaOrigem")
  transferenciasDeDestino Transferencia[] @relation("TransferenciaDestino")

  @@unique([companyId, omieCodigo])
  @@unique([id, companyId])
  @@map("contas_correntes")
}

/// Um arquivo de extrato bancário importado (PLU-339, Conciliação). O original fica no
/// armazenamento, isolado por empresa; o mesmo arquivo não entra duas vezes na conta.
model ExtratoBancario {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id")
  contaCorrenteId  String    @map("conta_corrente_id") @db.Uuid
  /// "ofx" ou "csv" (CHECK no banco).
  origem           String
  arquivoChave     String    @map("arquivo_chave")
  arquivoNome      String    @map("arquivo_nome")
  arquivoTamanho   Int       @map("arquivo_tamanho")
  arquivoSha256    String    @map("arquivo_sha256")
  periodoDe        DateTime  @map("periodo_de") @db.Timestamptz(6)
  periodoAte       DateTime  @map("periodo_ate") @db.Timestamptz(6)
  saldoInformado   Decimal?  @map("saldo_informado") @db.Decimal(14, 2)
  saldoInformadoEm DateTime? @map("saldo_informado_em") @db.Timestamptz(6)
  movimentos       Int
  novos            Int
  importadoPorId   String?   @map("importado_por_id") @db.Uuid
  importadoEm      DateTime  @default(now()) @map("importado_em") @db.Timestamptz(6)

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contaCorrente ContaCorrente        @relation(fields: [contaCorrenteId], references: [id], onDelete: Restrict)
  importadoPor  User?                @relation("ExtratoImportadoPor", fields: [importadoPorId], references: [id], onDelete: SetNull)
  linhas        MovimentoDoExtrato[]

  @@unique([contaCorrenteId, arquivoSha256])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([importadoPorId])
  @@map("extratos_bancarios")
}

/// Uma linha do extrato bancário: o valor com sinal (+ crédito, − débito). O identificador
/// do banco é único por conta. A descrição é dado bancário: não vai a log nem a evento.
model MovimentoDoExtrato {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id")
  contaCorrenteId String   @map("conta_corrente_id") @db.Uuid
  extratoId       String   @map("extrato_id") @db.Uuid
  /// O início do dia de Manaus.
  dia             DateTime @db.Timestamptz(6)
  valor           Decimal  @db.Decimal(14, 2)
  descricao       String
  identificador   String
  /// O TRNTYPE do OFX (FEE, SRVCHG...); nulo nos que entraram antes da C5 (PLU-339).
  tipoNoBanco     String?  @map("tipo_no_banco")
  /// "pendente", "conciliado" ou "marcado" (CHECK no banco).
  estado          String   @default("pendente")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// O lançamento do par (C3); a chave composta no banco garante a mesma conta.
  lancamentoId    String?   @unique @map("lancamento_id") @db.Uuid
  conciliadoEm    DateTime? @map("conciliado_em") @db.Timestamptz(6)
  conciliadoPorId String?   @map("conciliado_por_id") @db.Uuid

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contaCorrente ContaCorrente   @relation(fields: [contaCorrenteId], references: [id], onDelete: Restrict)
  extrato       ExtratoBancario @relation(fields: [extratoId], references: [id], onDelete: Restrict)
  lancamento    Lancamento?     @relation("ParDaConciliacao", fields: [lancamentoId], references: [id], onDelete: Restrict)
  /// Os lançamentos criados a partir desta linha na Conciliação (um vivo por linha: índice parcial no SQL).
  lancamentosCriados Lancamento[] @relation("LancamentoDaLinhaDoExtrato")
  conciliadoPor User?           @relation("MovimentoConciliadoPor", fields: [conciliadoPorId], references: [id], onDelete: SetNull)

  @@unique([contaCorrenteId, identificador])
  @@index([contaCorrenteId, dia])
  @@index([extratoId])
  @@index([companyId])
  @@map("movimentos_do_extrato")
}

/// A transferência entre duas contas da mesma empresa (PLU-339, C6), com número próprio
/// (TR-0001) e duas pernas em `lancamentos`. Empresa e autor sem relação no Prisma (as FKs
/// ficam no SQL). Só a gerência do Financeiro cria; nada se apaga.
model Transferencia {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Da sequência `transferencias_numero_seq`.
  numero         Int      @unique @default(autoincrement())
  companyId      String   @map("company_id")
  contaOrigemId  String   @map("conta_origem_id") @db.Uuid
  contaDestinoId String   @map("conta_destino_id") @db.Uuid
  valor          Decimal  @db.Decimal(14, 2)
  /// O início do dia de Manaus.
  dia            DateTime @db.Timestamptz(6)
  descricao      String
  criadaPorId    String?  @map("criada_por_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contaOrigem  ContaCorrente @relation("TransferenciaOrigem", fields: [contaOrigemId], references: [id], onDelete: Restrict)
  contaDestino ContaCorrente @relation("TransferenciaDestino", fields: [contaDestinoId], references: [id], onDelete: Restrict)
  pernas       Lancamento[]

  @@unique([id, companyId])
  @@index([contaOrigemId])
  @@index([contaDestinoId])
  @@map("transferencias")
}

/// O vínculo de uma categoria do Plugga OS com o OMIE (PLU-342), do conector. A empresa é
/// a da categoria (chave composta no banco). A aplicação só lê; a importação grava.
model OmieCategoria {
  categoriaId String    @id @map("categoria_id") @db.Uuid
  companyId   String    @map("company_id")
  omieCodigo  String    @map("omie_codigo")
  lidaEm      DateTime? @map("lida_em") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  categoria CategoriaFinanceira @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, omieCodigo])
  @@map("omie_categorias")
}

/// O vínculo de uma conta corrente do Plugga OS com o OMIE (PLU-342), do conector.
model OmieContaCorrente {
  contaCorrenteId String    @id @map("conta_corrente_id") @db.Uuid
  companyId       String    @map("company_id")
  omieCodigo      String    @map("omie_codigo")
  lidaEm          DateTime? @map("lida_em") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  contaCorrente ContaCorrente @relation(fields: [contaCorrenteId], references: [id], onDelete: Restrict)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, omieCodigo])
  @@map("omie_contas_correntes")
}

/// Saída (conta a pagar) ou entrada (cobrança de um cliente numa competência).
/// O banco garante que a categoria e a conta são da mesma empresa (chave
/// composta) e numera por tipo na inserção (gatilho).
model Lancamento {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                       FinanceiroTipoLancamento
  /// Preenchido pelo gatilho `lancamentos_numerar`; o valor enviado é ignorado.
  numero                     Int                      @default(0)
  companyId                  String                   @map("company_id")
  fornecedorId               String?                  @map("fornecedor_id") @db.Uuid
  clientId                   String?                  @map("client_id") @db.Uuid
  /// Nula na despesa ainda não classificada (CC14); a cobrança sempre tem (CHECK).
  categoriaId                String?                  @map("categoria_id") @db.Uuid
  contaCorrenteId            String?                  @map("conta_corrente_id") @db.Uuid
  descricao                  String
  valor                      Decimal                  @db.Decimal(14, 2)
  /// Início do dia de Manaus.
  vencimento                 DateTime                 @db.Timestamptz(6)
  /// "aaaa-mm", só na entrada.
  competencia                String?
  etapa                      FinanceiroEtapa
  forma                      FinanceiroForma?
  observacao                 String?
  origem                     FinanceiroOrigem
  pedidoDeCompraId           String?                  @unique @map("pedido_de_compra_id") @db.Uuid
  omieEstado                 FinanceiroEstadoOmie     @default(nao_enviado) @map("omie_estado")
  omieCodigo                 String?                  @map("omie_codigo")
  omieMotivo                 String?                  @map("omie_motivo")
  criadoPorId                String?                  @map("criado_por_id") @db.Uuid
  aprovadoEm                 DateTime?                @map("aprovado_em") @db.Timestamptz(6)
  aprovadoPorId              String?                  @map("aprovado_por_id") @db.Uuid
  /// Dia do pagamento (início do dia de Manaus).
  pagoEm                     DateTime?                @map("pago_em") @db.Timestamptz(6)
  pagamentoRegistradoEm      DateTime?                @map("pagamento_registrado_em") @db.Timestamptz(6)
  pagamentoRegistradoPorId   String?                  @map("pagamento_registrado_por_id") @db.Uuid
  /// Dia do recebimento (início do dia de Manaus).
  recebidoEm                 DateTime?                @map("recebido_em") @db.Timestamptz(6)
  valorRecebido              Decimal?                 @map("valor_recebido") @db.Decimal(14, 2)
  recebimentoRegistradoEm    DateTime?                @map("recebimento_registrado_em") @db.Timestamptz(6)
  recebimentoRegistradoPorId String?                  @map("recebimento_registrado_por_id") @db.Uuid
  /// Coluna GERADA no banco (GENERATED ALWAYS AS COALESCE(pago_em, recebido_em) STORED, a
  /// primeira do projeto): só leitura, a aplicação nunca grava. O Prisma a vê como coluna
  /// comum, então um `migrate dev`/`migrate diff` pode acusar diferença aqui: não é drift.
  liquidadoEm                DateTime?                @map("liquidado_em") @db.Timestamptz(6)
  conciliadoEm               DateTime?                @map("conciliado_em") @db.Timestamptz(6)
  conciliadoPorId            String?                  @map("conciliado_por_id") @db.Uuid
  /// "Marcar pendente" na conciliação: o pago que ainda não apareceu no extrato.
  conciliacaoMarcada         Boolean                  @default(false) @map("conciliacao_marcada")
  canceladoEm                DateTime?                @map("cancelado_em") @db.Timestamptz(6)
  canceladoPorId             String?                  @map("cancelado_por_id") @db.Uuid
  cancelamentoMotivo         String?                  @map("cancelamento_motivo")
  nfNumero                   String?                  @map("nf_numero")
  nfRegistradaEm             DateTime?                @map("nf_registrada_em") @db.Timestamptz(6)
  nfRegistradaPorId          String?                  @map("nf_registrada_por_id") @db.Uuid
  boletoRegistradoEm         DateTime?                @map("boleto_registrado_em") @db.Timestamptz(6)
  boletoRegistradoPorId      String?                  @map("boleto_registrado_por_id") @db.Uuid
  enviadoEm                  DateTime?                @map("enviado_em") @db.Timestamptz(6)
  envioCanal                 String?                  @map("envio_canal")
  enviadoPorId               String?                  @map("enviado_por_id") @db.Uuid
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                  Company             @relation(fields: [companyId], references: [id])
  fornecedor               Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  client                   Client?             @relation(fields: [clientId], references: [id])
  categoria                CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  contaCorrente            ContaCorrente?      @relation(fields: [contaCorrenteId], references: [id])
  pedidoDeCompra           PedidoDeCompra?     @relation(fields: [pedidoDeCompraId], references: [id])
  criadoPor                User?               @relation("LancamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  aprovadoPor              User?               @relation("LancamentoAprovadoPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  pagamentoRegistradoPor   User?               @relation("LancamentoPagamentoRegistradoPor", fields: [pagamentoRegistradoPorId], references: [id], onDelete: SetNull)
  recebimentoRegistradoPor User?               @relation("LancamentoRecebimentoRegistradoPor", fields: [recebimentoRegistradoPorId], references: [id], onDelete: SetNull)
  conciliadoPor            User?               @relation("LancamentoConciliadoPor", fields: [conciliadoPorId], references: [id], onDelete: SetNull)
  canceladoPor             User?               @relation("LancamentoCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  nfRegistradaPor         User?               @relation("LancamentoNfRegistradaPor", fields: [nfRegistradaPorId], references: [id], onDelete: SetNull)
  boletoRegistradoPor     User?               @relation("LancamentoBoletoRegistradoPor", fields: [boletoRegistradoPorId], references: [id], onDelete: SetNull)
  enviadoPor              User?               @relation("LancamentoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  anexos                  AnexoDeLancamento[]
  historico               HistoricoDeLancamento[]
  ucs                     UcDeLancamento[]
  omieEnvios              OmieEnvio[]
  /// O estado no OMIE, do conector; sem linha, `nao_enviado`.
  omie                    OmieLancamento?
  /// A linha do extrato bancário conciliada com o lançamento (PLU-339).
  movimentoDoExtrato      MovimentoDoExtrato? @relation("ParDaConciliacao")
  /// A linha do extrato de que o lançamento nasceu na Conciliação (criação guiada, tarifa ou a
  /// perna da transferência), conciliada ou não; gravada uma vez, não muda (gatilho).
  movimentoDeOrigemId     String?             @map("movimento_de_origem_id") @db.Uuid
  movimentoDeOrigem       MovimentoDoExtrato? @relation("LancamentoDaLinhaDoExtrato", fields: [movimentoDeOrigemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// A transferência entre contas da perna (C6); a perna leva o número dela (TR-0001).
  transferenciaId         String?             @map("transferencia_id") @db.Uuid
  transferencia           Transferencia?      @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)

  // (tipo, numero) é único fora das transferências: índice parcial `lancamentos_tipo_numero_key` no SQL.
  @@index([vencimento])
  @@index([tipo, etapa])
  @@index([fornecedorId])
  @@index([clientId])
  @@map("lancamentos")
}

/// O estado do lançamento no OMIE (PLU-342), do conector: derivado dos envios pelo
/// gatilho, que é o único a gravar. A aplicação só lê.
model OmieLancamento {
  lancamentoId String               @id @map("lancamento_id") @db.Uuid
  companyId    String               @map("company_id")
  estado       FinanceiroEstadoOmie @default(nao_enviado)
  codigo       String?
  motivo       String?
  updatedAt    DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Restrict)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("omie_lancamentos")
}

/// A conferência do par do OMIE de uma empresa (PLU-342): o último ListarEmpresas,
/// o bloqueio e a confirmação, válidos só para a versão do par em `segredoAtualizadoEm`.
model OmieConexao {
  companyId             String    @id @map("company_id")
  segredoAtualizadoEm   DateTime  @map("segredo_atualizado_em") @db.Timestamptz(6)
  ultimoTesteEm         DateTime? @map("ultimo_teste_em") @db.Timestamptz(6)
  ultimoTestePorId      String?   @map("ultimo_teste_por_id") @db.Uuid
  /// [{ razaoSocial, nomeFantasia, cnpj }], como o OMIE devolveu.
  ultimoTeste           Json?     @map("ultimo_teste") @db.JsonB
  bloqueio              String?
  confirmadaEm          DateTime? @map("confirmada_em") @db.Timestamptz(6)
  confirmadaPorId       String?   @map("confirmada_por_id") @db.Uuid
  cnpjConfirmado        String?   @map("cnpj_confirmado")
  razaoSocialConfirmada String?   @map("razao_social_confirmada")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company @relation(fields: [companyId], references: [id])
  ultimoTestePor  User?   @relation("OmieConexaoTestadaPor", fields: [ultimoTestePorId], references: [id], onDelete: SetNull)
  confirmadaPor   User?   @relation("OmieConexaoConfirmadaPor", fields: [confirmadaPorId], references: [id], onDelete: SetNull)

  @@map("omie_conexoes")
