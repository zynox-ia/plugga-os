/// Outbox do OMIE (PLU-342): o pedido de envio, gravado na transação que muda o
/// lançamento. O worker só muda o estado pelas funções do banco; um gatilho deriva
/// dele `Lancamento.omieEstado`. Sem DELETE para ninguém.
model OmieEnvio {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Identidade gerada no banco (GENERATED ALWAYS): a ordem dos envios de um lançamento.
  ordem              BigInt            @default(autoincrement())
  lancamentoId       String            @map("lancamento_id") @db.Uuid
  /// A empresa do lançamento (o gatilho confere na inserção).
  companyId          String            @map("company_id")
  operacao           OmieOperacao
  estado             OmieEstadoDoEnvio @default(pendente)
  tentativas         Int               @default(0)
  proximaTentativaEm DateTime          @default(now()) @map("proxima_tentativa_em") @db.Timestamptz(6)
  /// Só o motivo curto (OmieFalhouError), nunca a resposta do OMIE.
  ultimoErro         String?           @map("ultimo_erro")
  codigoOmie         String?           @map("codigo_omie")
  enviadoEm          DateTime?         @map("enviado_em") @db.Timestamptz(6)
  criadoPorId        String?           @map("criado_por_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Restrict)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  criadoPor  User?      @relation("OmieEnvioCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([lancamentoId, ordem])
  @@index([companyId])
  @@index([criadoPorId])
  @@map("omie_envios")
}

/// Pausa de uma empresa num método do OMIE (limite de consumo) ou na empresa toda
/// (`*`, credenciais recusadas). Só o worker grava, pela função do banco.
model OmiePausa {
  companyId String   @map("company_id")
  metodo    String
  ate       DateTime @db.Timestamptz(6)
  motivo    String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, metodo])
  @@map("omie_pausas")
}

