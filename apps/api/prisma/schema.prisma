generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorType {
  user
  agent
  system

  @@map("actor_type")
}

enum IntegrationMode {
  mock
  read_only
  bridge
  write

  @@map("integration_mode")
}

enum IntegrationStatus {
  healthy
  degraded
  down
  unknown

  @@map("integration_status")
}

enum JobRunStatus {
  queued
  running
  success
  failed
  skipped

  @@map("job_run_status")
}

enum AuthTokenType {
  invite
  reset

  @@map("auth_token_type")
}

enum EvSegment {
  r0
  r1
  r2
  r3
  r4
  r5
  r6

  @@map("ev_segment")
}

enum EvSessionStatus {
  active
  completed
  failed
  blocked

  @@map("ev_session_status")
}

enum LocationStatus {
  active
  inactive
  unknown

  @@map("location_status")
}

enum IncidentStatus {
  open
  investigating
  resolved
  blocked

  @@map("incident_status")
}

enum SettlementStatus {
  draft
  auditing
  ready_for_review
  approved
  exported
  blocked

  @@map("settlement_status")
}

enum ClientSegment {
  prospect
  opm
  pluggamob
  associacoes_gd
  inativo

  @@map("client_segment")
}

enum OpportunityStage {
  leads
  qualificacao
  proposta
  decisao

  @@map("opportunity_stage")
}

enum OpportunityStatus {
  aberta
  ganha
  perdida
  revisitar

  @@map("opportunity_status")
}

enum ContractStatus {
  rascunho
  revisao_interna
  aguardando_assinatura
  ativo
  vencendo
  encerrado

  @@map("contract_status")
}

model User {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique
  name          String
  status        String          @default("active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles         UserRole[]
  agentActions  AgentAction[]
  credential    UserCredential?
  sessions      Session[]
  authTokens    AuthToken[]
  opportunities Opportunity[]
  contracts     Contract[]

  @@map("users")
}

/// Password credential, 1:1 with a user. Argon2id hash only; never logged.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Opaque server-side session. Only the token hash is stored; revocation is a
/// delete. Sliding expiry (expiresAt) capped by an absolute deadline.
model Session {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ip                String?
  userAgent         String?  @map("user_agent")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use invite/reset token. Only the hash is stored; consumedAt marks use.
model AuthToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Role {
  id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key   String     @unique
  name  String
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Append-only audit record. The initial migration prevents UPDATE and DELETE.
model AgentAction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent          String
  requestedById  String?  @map("requested_by") @db.Uuid
  channel        String
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  input          Json     @db.JsonB
  payload        Json     @db.JsonB
  decision       String
  approvalStatus String   @map("approval_status")
  status         String
  result         String?
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  requestedBy    User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("agent_actions")
}

/// Append-only event record. actorId is polymorphic by actorType.
model EventLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName  String    @map("event_name")
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  payload    Json      @db.JsonB
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventName, occurredAt])
  @@index([entityType, entityId])
  @@map("event_log")
}

model Integration {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String            @unique
  name       String
  mode       IntegrationMode   @default(mock)
  status     IntegrationStatus @default(unknown)
  lastSyncAt DateTime?         @map("last_sync_at") @db.Timestamptz(6)
  lastError  String?           @map("last_error")
  owner      String
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobRuns    JobRun[]

  @@map("integrations")
}

/// Read-only mirror of Bitrix records, one row per (domain, external record)
/// (ADR-0009). Raw payload staging into the OS Postgres; mapping to OS domain
/// models is later phase work. Idempotent upsert keyed by (domain, externalId);
/// sourceFingerprint lets a re-import skip unchanged records.
model BitrixMirrorRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain            String
  externalId        String   @map("external_id")
  payload           Json     @db.JsonB
  sourceFingerprint String   @map("source_fingerprint")
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([domain, externalId])
  @@index([domain])
  @@map("bitrix_mirror_records")
}

model JobRun {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey        String       @map("job_key")
  integrationId String?      @map("integration_id") @db.Uuid
  scheduledFor  DateTime?    @map("scheduled_for") @db.Timestamptz(6)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(6)
  status        JobRunStatus
  attempt       Int          @default(1)
  durationMs    Int?         @map("duration_ms")
  error         String?
  triggeredBy   String       @map("triggered_by")
  logRef        String?      @map("log_ref")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([jobKey, scheduledFor])
  @@index([integrationId])
  @@map("job_runs")
}

model EvUser {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId     String             @unique @map("external_id")
  displayName    String             @map("display_name")
  phoneMasked    String?            @map("phone_masked")
  segment        EvSegment          @default(r0)
  optedOutAt     DateTime?          @map("opted_out_at") @db.Timestamptz(6)
  walletBalance  Decimal?           @map("wallet_balance") @db.Decimal(14, 2)
  lastSessionAt  DateTime?          @map("last_session_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  segmentHistory EvSegmentHistory[]
  contacts       EvContact[]
  sessions       EvSession[]
  coupons        Coupon[]
  incidents      Incident[]

  @@index([segment, optedOutAt])
  @@map("ev_users")
}

model EvSegmentHistory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  segment   EvSegment
  changedAt DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  user      EvUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@map("ev_segment_history")
}

model EvContact {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  channel      String
  outcome      String
  nextActionAt DateTime?  @map("next_action_at") @db.Timestamptz(6)
  sessionId    String?    @map("session_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         EvUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      EvSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ev_contacts")
}

model Partner {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String       @unique
  name        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  locations   Location[]
  settlements Settlement[]

  @@map("partners")
}

model Location {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String         @map("partner_id") @db.Uuid
  name      String
  status    LocationStatus @default(unknown)
  timezone  String         @default("America/Manaus")
  partner   Partner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  stations  Station[]
  sessions  EvSession[]
  incidents Incident[]

  @@index([partnerId, status])
  @@map("locations")
}

model Station {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String      @map("location_id") @db.Uuid
  name       String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  connectors Connector[]

  @@map("stations")
}

model Connector {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId String      @map("station_id") @db.Uuid
  label     String
  status    String      @default("unknown")
  station   Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sessions  EvSession[]

  @@map("connectors")
}

model EvSession {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId     String          @unique @map("external_id")
  userId         String          @map("user_id") @db.Uuid
  locationId     String          @map("location_id") @db.Uuid
  connectorId    String?         @map("connector_id") @db.Uuid
  tokenRfid      String?         @map("token_rfid")
  status         EvSessionStatus
  startedAt      DateTime        @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(6)
  kwh            Decimal?        @db.Decimal(14, 3)
  amount         Decimal?        @db.Decimal(14, 2)
  user           EvUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  connector      Connector?      @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  incidents      Incident[]
  settlementLine SettlementLine?
  contacts       EvContact[]
  coupons        Coupon[]

  @@index([locationId, status])
  @@index([userId, startedAt])
  @@map("ev_sessions")
}

model Incident {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         String
  status       IncidentStatus @default(open)
  severity     String
  summary      String
  owner        String?
  userId       String?        @map("user_id") @db.Uuid
  sessionId    String?        @map("session_id") @db.Uuid
  locationId   String?        @map("location_id") @db.Uuid
  settlementId String?        @map("settlement_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user         EvUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session      EvSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  settlement   Settlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("incidents")
}

model Coupon {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @unique
  status    String
  userId    String?    @map("user_id") @db.Uuid
  sessionId String?    @map("session_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user      EvUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   EvSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("coupons")
}

model Settlement {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String           @map("partner_id") @db.Uuid
  weekStart DateTime         @map("week_start") @db.Timestamptz(6)
  weekEnd   DateTime         @map("week_end") @db.Timestamptz(6)
  status    SettlementStatus @default(draft)
  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines     SettlementLine[]
  credits   D14Credit[]
  incidents Incident[]

  @@unique([partnerId, weekStart])
  @@map("settlements")
}

model SettlementLine {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId   String     @map("settlement_id") @db.Uuid
  sessionId      String?    @unique @map("session_id") @db.Uuid
  tokenRfid      String?    @map("token_rfid")
  classification String
  amount         Decimal?   @db.Decimal(14, 2)
  blockedReason  String?    @map("blocked_reason")
  settlement     Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  session        EvSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([settlementId, blockedReason])
  @@map("settlement_lines")
}

model D14Credit {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String     @map("settlement_id") @db.Uuid
  amount       Decimal    @db.Decimal(14, 2)
  status       String
  availableAt  DateTime   @map("available_at") @db.Timestamptz(6)
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@map("d14_credits")
}

/// Unique client record. The rest of the product (opportunities, contracts,
/// PluggaMob ficha) links to this row instead of duplicating identity.
model Client {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  company       String?
  phone         String?
  email         String?
  externalId    String?       @map("external_id")
  segment       ClientSegment @default(prospect)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  opportunities Opportunity[]
  contracts     Contract[]

  @@index([segment, active])
  @@map("clients")
}

/// A commercial opportunity worked from lead to a ganha/perdida decision.
/// clientId is null until the opportunity is won or explicitly linked.
model Opportunity {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String?              @map("client_id") @db.Uuid
  title          String
  product        String
  stage          OpportunityStage     @default(leads)
  status         OpportunityStatus    @default(aberta)
  ownerId        String?              @map("owner_id") @db.Uuid
  estimatedValue Decimal?             @map("estimated_value") @db.Decimal(14, 2)
  nextActionAt   DateTime?            @map("next_action_at") @db.Timestamptz(6)
  nextActionNote String?              @map("next_action_note")
  lossReason     String?              @map("loss_reason")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  client         Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner          User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       OpportunityContact[]
  contracts      Contract[]

  @@index([stage, status])
  @@index([clientId])
  @@map("opportunities")
}

model OpportunityContact {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  channel       String
  outcome       String
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("opportunity_contacts")
}

/// Contract lifecycle. Always tied to a client; may originate from a won
/// opportunity or be opened directly on the client's ficha.
model Contract {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String         @map("client_id") @db.Uuid
  opportunityId String?        @map("opportunity_id") @db.Uuid
  status        ContractStatus @default(rascunho)
  ownerId       String?        @map("owner_id") @db.Uuid
  startsAt      DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?      @map("ends_at") @db.Timestamptz(6)
  signedAt      DateTime?      @map("signed_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clientId])
  @@map("contracts")
}
